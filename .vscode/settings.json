{
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (TeX Live/MiKTeX)",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "tectonic (nhe, khong can TeX Live)",
      "tools": [
        "tectonic"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "%DOC%"
      ],
      "env": {}
    },
    {
      "name": "tectonic",
      "command": "tectonic",
      "args": [
        "-X",
        "compile",
        "%DOC_EXT%",
        "--outdir",
        "%OUTDIR%",
        "--synctex",
        "--keep-logs"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoClean.run": "onFailed",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "[latex]": {
    "editor.wordWrap": "on"
  },
  "latex-workshop.latex.clean.method": "cleanCommand",
  "latex-workshop.latex.clean.command": "latexmk",
  "latex-workshop.latex.clean.args": [
    "-c",
    "%DOC%"
  ]
}
