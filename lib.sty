% -------------------- TIÊU ĐỀ & ĐỊNH DẠNG --------------------
\usepackage{titlesec}    
% Tùy chỉnh tiêu đề section
\setcounter{secnumdepth}{4} 
\setcounter{tocdepth}{3} %mục lục cấp 4
\titleformat{\paragraph}
  {\normalfont\normalsize\bfseries}{\theparagraph}{1em}{}
\titlespacing*{\paragraph}{0pt}{3.25ex plus 1ex minus .2ex}{1.5ex plus .2ex}
\ifdefined\DeclareUnicodeCharacter\DeclareUnicodeCharacter{2212}{-}\fi % chi pdfLaTeX can; XeTeX/Tectonic bo qua

% Định dạng hiển thị tiêu đề
\titleformat{\section}{\bfseries\Large}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\bfseries\large}{\thesubsection.}{0.5em}{}
\titleformat{\subsubsection}{\bfseries\normalsize}{\thesubsubsection.}{0.5em}{}


