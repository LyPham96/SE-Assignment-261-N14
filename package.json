{
  "name": "pikepike",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:api && npm run test -w server",
    "verify": "npm run build && npm run build -w server && npm test",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "screenshots": "node scripts/screenshots.mjs",
    "android:add": "cap add android",
    "android:sync": "node --env-file-if-exists=.env scripts/android.mjs sync",
    "android:build": "node --env-file-if-exists=.env scripts/android.mjs build",
    "android:open": "cap open android",
    "api:start": "npm run start -w server",
    "db:migrate": "npm run migrate:m1-m2 -w server",
    "db:seed": "npm run seed:m1-m2 -w server",
    "test:api": "npm run test:m1-m2 -w server",
    "test:e2e": "node scripts/demo-e2e.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.51.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  },
  "workspaces": [
    "server"
  ],
  "engines": {
    "node": "24.x"
  }
}
