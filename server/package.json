{
  "name": "@pikepike/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts",
    "migrate": "node-pg-migrate up -m migrations --envPath ../.env",
    "seed": "node --env-file-if-exists=../.env dist/seed.js",
    "migrate:m1-m2": "node --env-file-if-exists=../.env src/migrate.mjs",
    "seed:m1-m2": "node --env-file-if-exists=../.env src/seed.mjs",
    "test:m1-m2": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/swagger": "^9.9.5",
    "fastify": "^5.12.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "@fastify/cookie": "^11.0.0",
    "@fastify/swagger-ui": "^6.1.4"
  }
}
